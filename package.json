{
	"name": "harness-monorepo",
	"version": "0.1.0",
	"description": "Harness AI aziendale: motore di enforcement agent-agnostic e piattaforma amministrativa per configurazioni/policy centralizzate.",
	"private": true,
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "https://github.com/3n1gm496/harness.git"
	},
	"homepage": "https://github.com/3n1gm496/harness#readme",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"clean": "npm run clean --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:pg": "node scripts/test-with-postgres.mjs",
		"load-test": "npm run build && node scripts/load-test.mjs",
		"typecheck": "tsc --build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"example:mock-agent": "npm run build && node examples/mock-agent/run.mjs",
		"example:native-agent": "npm run build && node examples/native-agent/run.mjs",
		"smoke:live-provider": "npm run build && node scripts/live-provider-smoke.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "22.10.2",
		"typescript": "5.7.2"
	}
}
