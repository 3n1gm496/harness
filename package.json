{
	"name": "harness-monorepo",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"clean": "npm run clean --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:pg": "node scripts/test-with-postgres.mjs",
		"typecheck": "tsc --build",
		"example:mock-agent": "npm run build && node examples/mock-agent/run.mjs"
	},
	"devDependencies": {
		"@types/node": "22.10.2",
		"typescript": "5.7.2"
	}
}
