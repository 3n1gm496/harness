# Client gestito sandboxato: PI + agent-client + estensione fleet.
# PI non ha sandbox propria: questo container È il confine di sicurezza.
# Montare solo la workspace, limitare l'egress a control plane e gateway LLM.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.base.json ./
COPY packages ./packages
RUN npm ci --ignore-scripts && npm run build

FROM node:22-bookworm-slim
# Versione pinnata: lo shim dei tipi della Extension API
# (packages/fleet-extension/src/pi-types.ts) è allineato a questa release.
# Aggiornare insieme: bump qui → riverificare/aggiornare lo shim → ritestare.
ARG PI_CODING_AGENT_VERSION=0.80.3
RUN apt-get update \
	&& apt-get install -y --no-install-recommends bash ca-certificates git ripgrep \
	&& rm -rf /var/lib/apt/lists/* \
	&& npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION}"
COPY --from=build /app /opt/harness
# Marker della sandbox sanzionata: la sua presenza attesta che l'agente gira
# dentro questo container ufficiale. La policy di default (sandbox.required)
# rifiuta l'esecuzione senza questo marker. Va mantenuto read-only e non
# replicato fuori dall'immagine. Per un valore per-immagine, sovrascrivere
# markerValue nella policy e scrivere qui lo stesso valore.
RUN printf '%s' "" > /opt/harness/sandbox-marker && chmod 0444 /opt/harness/sandbox-marker
ENV PATH="/opt/harness/node_modules/.bin:${PATH}" \
	PI_SKIP_VERSION_CHECK=1
USER node
WORKDIR /workspace
# Flusso tipico:
#   docker run ... harness-agent enroll --url https://cp.azienda.it --token enr_...
#   docker run ... harness-agent run
ENTRYPOINT ["node", "/opt/harness/packages/agent-client/dist/cli.js"]
CMD ["status"]
