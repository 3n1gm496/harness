# Copia in deploy/.env e valorizza prima di avviare il compose:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up --build
#
# In alternativa, esporta le variabili nella shell prima di `docker compose up`.

# KEK per l'envelope encryption delle chiavi di firma a riposo (obbligatoria).
# Generane una nuova, non riusare questo file per produzione:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HARNESS_SIGNING_KEK=

# Solo se abiliti il profilo `gateway` (docker compose --profile gateway up).
# Il gateway accetta, per ciascun provider, UNA di queste fonti di credenziale:
#
#   a) API key metered (fatturata a token):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
#
#   b) Token di account/sessione (OAuth) — usa l'abbonamento, non il credito API.
#      Va inviato come Authorization: Bearer (mai come x-api-key). Ottienilo dal
#      login ufficiale del provider. Con *_AUTH_TOKEN_FILE il token viene riletto
#      a ogni richiesta, così un processo esterno può rinnovarlo senza riavvii.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_AUTH_TOKEN_FILE=/run/secrets/anthropic-oauth-token
# ANTHROPIC_AUTH_BETA=oauth-2025-04-20
# OPENAI_AUTH_TOKEN=
# OPENAI_AUTH_TOKEN_FILE=/run/secrets/openai-oauth-token
#
#   c) GRATIS con un modello locale (nessuna chiave): backend OpenAI-compatibile
#      senza auth (Ollama/llama.cpp/LM Studio/vLLM). Punta OPENAI_BASE_URL al
#      backend (senza /v1 finale) e attiva OPENAI_NO_AUTH.
# OPENAI_NO_AUTH=1
# OPENAI_BASE_URL=http://host.docker.internal:11434
