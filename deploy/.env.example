# Copia in deploy/.env e valorizza prima di avviare il compose:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up --build
#
# In alternativa, esporta le variabili nella shell prima di `docker compose up`.

# KEK per l'envelope encryption delle chiavi di firma a riposo (obbligatoria).
# Generane una nuova, non riusare questo file per produzione:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HARNESS_SIGNING_KEK=

# Solo se abiliti il profilo `gateway` (docker compose --profile gateway up):
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
